        {
          "datasource": {
            "type": "postgres",
            "uid": "TimescaleDB"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT timestamp, symbol, anomaly_type, percent_change, current_price, previous_price FROM stock_anomalies ORDER BY timestamp DESC LIMIT 100;",
          "refId": "B"
        }
      ]
    }
