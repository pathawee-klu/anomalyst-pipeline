# Pipeline Mode Configuration
MOCK_MODE=true
SYMBOLS=AAPL,GOOGL,TSLA,NVDA

# Finnhub API Configuration
FINNHUB_API_KEY=your_finnhub_api_key_here

# LINE Messaging API Configuration
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
LINE_USER_ID=your_line_user_or_group_id_here

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_RAW_TICKS=stock-raw-ticks
KAFKA_TOPIC_ANOMALIES=stock-anomalies

# TimescaleDB / PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=stock_monitoring
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Anomaly Detection Settings
ANOMALY_PERCENT_CHANGE_THRESHOLD=2.0
ANOMALY_WINDOW_SECONDS=60
